# IteraDynamics environment configuration
# Copy to .env and fill in values

# ── Data ──────────────────────────────────────────────────────────────────────
DATA_DIR=data
ARTIFACTS_DIR=artifacts
DEBUG_DIR=debug

# ── Default asset / timeframe ─────────────────────────────────────────────────
DEFAULT_ASSET=BTC
DEFAULT_TIMEFRAME=1h

# ── Research harness defaults ─────────────────────────────────────────────────
INITIAL_CAPITAL=100000.0
FEE_RATE=0.0006          # 0.06% per trade (taker)
SLIPPAGE_BPS=5           # 5 bps slippage estimate

# ── Runtime / paper trading ───────────────────────────────────────────────────
PAPER_BROKER_INITIAL_CASH=100000.0
RUNTIME_POLL_INTERVAL_SECONDS=3600   # 1h for hourly bars
RUNTIME_STATE_PATH=runtime/argus/state/live_state.json

# ── Governor limits ───────────────────────────────────────────────────────────
MAX_PORTFOLIO_EXPOSURE_FRAC=1.0      # max gross exposure as fraction of NAV
MAX_SINGLE_STRATEGY_EXPOSURE_FRAC=1.0
MAX_DRAWDOWN_HALT_FRAC=0.20          # halt if portfolio drawdown exceeds 20%
MIN_TRADE_NOTIONAL_USD=50.0

# ── Exchange (live stub — not wired to real exchange in open-source release) ──
EXCHANGE_NAME=stub
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
