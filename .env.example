# IteraDynamics environment configuration
# Copy to .env and fill in values

# ── Data ──────────────────────────────────────────────────────────────────────
DATA_DIR=data
ARTIFACTS_DIR=artifacts
DEBUG_DIR=debug

# ── Default asset / timeframe ─────────────────────────────────────────────────
DEFAULT_ASSET=BTC
DEFAULT_TIMEFRAME=1h

# ── Research harness defaults ─────────────────────────────────────────────────
INITIAL_CAPITAL=100000.0

# ── Execution model (shared: backtest engine + paper broker) ──────────────────
# Fees
FEE_RATE=0.0006              # Taker fee rate (6 bps — Coinbase Advanced default)
USE_MAKER_FEES=false          # Set true to use maker rate instead
MAKER_FEE_RATE=0.0002         # Maker fee rate (2 bps)

# Slippage: bps = BASE + SIZE_FACTOR*(notional/nav) + VOL_FACTOR*atr_pct
BASE_SLIPPAGE_BPS=3.0         # Minimum friction per trade
SLIPPAGE_SIZE_FACTOR=10.0     # Extra bps per 100% NAV turnover
SLIPPAGE_VOL_FACTOR=50.0      # Extra bps per 100% ATR
MIN_SLIPPAGE_BPS=1.0          # Hard floor on slippage component
MAX_SLIPPAGE_BPS=50.0         # Hard ceiling on slippage component

# Spread (half-spread per side): bps = max(MIN_SPREAD, K * atr_pct * 10000 / 2)
SPREAD_K=0.5
MIN_SPREAD_BPS=1.0

# Large trade penalty (nonlinear slippage above threshold)
LARGE_TRADE_THRESHOLD=0.25    # Fraction of NAV; above this, marginal slippage doubles

# Cooldown between trades (bars)
COOLDOWN_BARS=0               # 0 = disabled; 2 = no trades within 2 bars of last trade

# Rebalance threshold — min exposure delta to trigger a trade
REBALANCE_THRESHOLD=0.02      # 2% = only trade if target exposure differs by > 2% from current

# ── Runtime / paper trading ───────────────────────────────────────────────────
PAPER_BROKER_INITIAL_CASH=100000.0
RUNTIME_POLL_INTERVAL_SECONDS=3600   # 1h for hourly bars
RUNTIME_STATE_PATH=runtime/argus/state/live_state.json

# ── Governor limits ───────────────────────────────────────────────────────────
MAX_PORTFOLIO_EXPOSURE_FRAC=1.0      # max gross exposure as fraction of NAV
MAX_SINGLE_STRATEGY_EXPOSURE_FRAC=1.0
MAX_DRAWDOWN_HALT_FRAC=0.20          # halt if portfolio drawdown exceeds 20%
MIN_TRADE_NOTIONAL_USD=50.0

# ── Exchange (live stub — not wired to real exchange in open-source release) ──
EXCHANGE_NAME=stub
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
